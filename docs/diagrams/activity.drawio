          <mxGeometry x="20" y="580" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_sys_disp_inst" value="Display Step-by-Step Instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_system">
          <mxGeometry x="20" y="670" width="140" height="60" as="geometry" />
