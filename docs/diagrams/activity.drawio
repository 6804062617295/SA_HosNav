          <mxGeometry x="105" y="760" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_sys_update_called" value="Update Queue Status to Called" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_system">
