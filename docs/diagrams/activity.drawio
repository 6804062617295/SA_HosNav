<mxfile host="app.diagrams.net">
  <diagram id="activity_diag" name="Activity Diagram">
    <mxGraphModel dx="1422" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Swimlanes -->
        <mxCell id="lane_patient" value="Patient" style="swimlane;startSize=20;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="350" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="lane_system" value="System" style="swimlane;startSize=20;html=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="40" width="350" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="lane_staff" value="Staff" style="swimlane;startSize=20;html=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="350" height="1100" as="geometry" />
        </mxCell>
        <!-- PHASE 1: Queue Creation -->
        <mxCell id="start_node" style="ellipse;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="lane_staff">
          <mxGeometry x="160" y="40" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="act_staff_create" value="Create Queue (Standard Entry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_staff">
          <mxGeometry x="105" y="100" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_sys_gen_qr" value="Generate Queue &amp; QR Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_system">
          <mxGeometry x="105" y="100" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_sys_disp_qr" value="Display QR to Staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_system">
          <mxGeometry x="105" y="190" width="140" height="60" as="geometry" />
        </mxCell>
        <!-- PHASE 2: Patient Enters Queue -->
        <mxCell id="act_pat_scan_qr" value="Scan Queue QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_patient">
          <mxGeometry x="105" y="280" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_sys_link_pat" value="Link Patient to Queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_system">
          <mxGeometry x="105" y="280" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_sys_disp_status" value="Display Queue Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_system">
          <mxGeometry x="105" y="370" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act_pat_view_status" value="View Queue Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_patient">
          <mxGeometry x="105" y="370" width="140" height="60" as="geometry" />
        </mxCell>
        <!-- PHASE 4: Navigation -->
        <mxCell id="dec_need_nav" value="Need Navigation?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_patient">
          <mxGeometry x="115" y="470" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="act_pat_scan_cp" value="Scan QR Checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_patient">
          <mxGeometry x="20" y="580" width="140" height="60" as="geometry" />
        </mxCell>
