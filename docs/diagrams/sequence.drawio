        <mxCell id="m3_27" value="Notification: Your queue is called!" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1" source="ll_patient_pwa" target="ll_patient">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
