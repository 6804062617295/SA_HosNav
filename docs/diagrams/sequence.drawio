          </mxGeometry>
        </mxCell>
        <mxCell id="note_pat_side" value="--- Patient side (via polling) ---" style="text;align=left;fontStyle=1;fontSize=12;fillColor=#ffffcc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="50" y="1280" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m3_25" value="GET /api/queues/:id/status" style="endArrow=classic;html=1;" edge="1" parent="1" source="ll_patient_pwa" target="ll_api">
          <mxGeometry relative="1" as="geometry">
